{
  "name": "jira-markdown-exporter",
  "version": "0.2.5",
  "description": "Read-only Jira issue snapshots as deterministic Markdown packets.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./profiles/*": "./profiles/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doruksahin/jira-markdown-exporter.git"
  },
  "homepage": "https://github.com/doruksahin/jira-markdown-exporter#readme",
  "bugs": {
    "url": "https://github.com/doruksahin/jira-markdown-exporter/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "jira-markdown-export": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "profiles",
    "schemas",
    "README.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test",
    "export": "tsx src/cli/main.ts",
    "prepack": "pnpm build",
    "release:check": "pnpm check && npm pack --dry-run"
  },
  "dependencies": {
    "adf-to-md": "^1.2.1",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "jira.js": "^5.3.1",
    "liquidjs": "^10.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
