{
  "name": "@adcreative/jira-markdown-exporter",
  "version": "0.1.0",
  "description": "Read-only Jira issue snapshots as deterministic Markdown packets.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doruksahin/jira-markdown-exporter.git"
  },
  "homepage": "https://github.com/doruksahin/jira-markdown-exporter#readme",
  "bugs": {
    "url": "https://github.com/doruksahin/jira-markdown-exporter/issues"
  },
  "engines": { "node": ">=20" },
  "bin": { "jira-markdown-export": "dist/cli/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test",
    "export": "tsx src/cli/main.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "adf-to-md": "^1.2.1",
    "dotenv": "^17.4.2",
    "jira.js": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
