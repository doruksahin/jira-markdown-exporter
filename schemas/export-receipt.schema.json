{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/doruk/jira-markdown-exporter/schemas/export-receipt.schema.json",
  "title": "Jira Markdown Export Receipt",
  "type": "object",
  "required": ["schemaVersion", "status", "total", "synced", "failed", "outputDir", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["success", "partial", "failed"] },
    "total": { "type": "integer", "minimum": 0 },
    "synced": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "outputDir": { "type": "string" },
    "issues": { "type": "array", "items": { "type": "object", "required": ["key", "status"], "properties": { "key": { "type": "string" }, "status": { "enum": ["synced", "failed"] }, "issueDir": { "type": "string" }, "comments": { "type": "integer", "minimum": 0 }, "attachments": { "type": "integer", "minimum": 0 }, "downloadedAttachments": { "type": "integer", "minimum": 0 }, "warnings": { "type": "array", "items": { "type": "string" } }, "error": { "type": "string" }, "failure": { "$ref": "#/$defs/transportFailure" } }, "additionalProperties": false } },
    "error": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "transportFailure": {
      "type": "object",
      "required": ["code", "operation", "summary"],
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "operation": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 120 },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "transportCode": { "type": "string", "maxLength": 64 },
        "retryable": { "type": "boolean" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": false
    }
  }
}
